<style>
  .sidebar-inner {
    padding: 0 1.125rem;
    text-align: center;
  }

  .portrait {
    background-image: url('/src/assets/portrait.jpg');
    background-size: cover;
    display: inline-block;
    border-radius: 40px;
    width: 80px;
    height: 80px;
    margin-bottom: 0.75rem;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .bio {
    font-size: 0.9rem;
    color: hsla(0, 0%, 0%, 0.5);
    margin: 0;
  }

  .links ul {
    list-style: none;
    margin: 0.35rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
  }

  .links li {
    padding: 0;
    margin: 0;
  }

  .links li a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    background: #ebebeb;
    border-radius: 0.1875rem;
    color: #555;
  }

  .links li a svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .links, .menu {
    margin: 1.25rem 0 0 0;
  }

  .menu ul {
    list-style: none;
    margin: 0;
  }

  .menu li {
    margin: 0.625rem 0;
  }

  .menu a {
    color: #222;
    font-size: 1rem;
    font-weight: 400;
  }

  .menu a.active {
    border-bottom: 1px solid #222;
  }

  .menu a:hover {
    text-decoration: none;
    color: #2a6496;
    border-bottom: 1px solid #2a6496;
  }

  @media screen and (min-width: 960px) {
    .sidebar-inner {
      text-align: left;
      padding: 0 2.5rem;
    }
    .links ul {
      justify-content: flex-start;
    }
  }
</style>
